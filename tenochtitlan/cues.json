[{"id": "p1.0", "t0": 3.0, "t1": 5.723, "text": "这是墨西哥城的特拉尔潘大道"}, {"id": "p1.1", "t0": 5.763, "t1": 8.026, "text": "笔直地通向城市中心"}, {"id": "p2.0", "t0": 8.476, "t1": 12.432, "text": "五百年前，这条路是湖面上的一道石堤"}, {"id": "p3.0", "t0": 13.282, "t1": 15.855, "text": "今天两千多万人生活的地方"}, {"id": "p3.1", "t0": 15.895, "t1": 17.987, "text": "那时大半是一片湖"}, {"id": "p4.0", "t0": 18.237, "t1": 21.761, "text": "湖中央的岛上，是阿兹特克帝国的首都"}, {"id": "p4.1", "t0": 21.801, "t1": 23.601, "text": "特诺奇蒂特兰"}, {"id": "p5.0", "t0": 23.859, "t1": 26.87, "text": "两年半之内，它被围困、攻破"}, {"id": "p5.1", "t0": 26.91, "t1": 28.71, "text": "最后夷为平地"}, {"id": "c1_1.0", "t0": 40.318, "t1": 41.823, "text": "1519年2月"}, {"id": "c1_1.1", "t0": 41.863, "t1": 45.083, "text": "埃尔南·科尔特斯从古巴出发"}, {"id": "c1_2.0", "t0": 45.133, "t1": 48.979, "text": "11艘船，大约500名士兵，16匹马"}, {"id": "c1_3.0", "t0": 49.129, "t1": 52.479, "text": "古巴总督已经撤销了他的指挥权"}, {"id": "c1_3.1", "t0": 52.519, "t1": 54.564, "text": "他是违令出航的"}, {"id": "c1_4.0", "t0": 56.714, "t1": 57.982, "text": "在科苏梅尔岛"}, {"id": "c1_4.1", "t0": 58.022, "t1": 62.343, "text": "他找到一个在玛雅人中生活了八年的西班牙人"}, {"id": "c1_4.2", "t0": 62.383, "t1": 64.183, "text": "阿吉拉尔"}, {"id": "c1_5.0", "t0": 66.255, "t1": 68.805, "text": "3月，在塔巴斯科的波通昌"}, {"id": "c1_5.1", "t0": 68.845, "t1": 70.922, "text": "远征队打了第一仗"}, {"id": "c1_6.0", "t0": 71.072, "t1": 74.411, "text": "战败的玛雅首领送来20名女子"}, {"id": "c1_6.1", "t0": 74.451, "t1": 77.939, "text": "其中一位，后来被称为玛林切"}, {"id": "c1_7.0", "t0": 77.989, "t1": 79.226, "text": "她会说玛雅语"}, {"id": "c1_7.1", "t0": 79.266, "t1": 82.596, "text": "也会说阿兹特克人的纳瓦特尔语"}, {"id": "c1_8.0", "t0": 82.646, "t1": 85.646, "text": "纳瓦特尔语，玛雅语，西班牙语"}, {"id": "c1_8.1", "t0": 85.686, "t1": 88.424, "text": "一条翻译链就这样接上了"}, {"id": "c1_9.0", "t0": 92.574, "t1": 93.573, "text": "4月21日"}, {"id": "c1_9.1", "t0": 93.613, "t1": 97.081, "text": "船队在今天的韦拉克鲁斯附近靠岸"}, {"id": "c1_10.0", "t0": 97.231, "t1": 100.709, "text": "阿兹特克皇帝蒙特祖马二世派来使者"}, {"id": "c1_10.1", "t0": 100.749, "t1": 102.638, "text": "送来黄金和礼物"}, {"id": "c1_11.0", "t0": 102.688, "t1": 106.105, "text": "礼物没能让他们离开，反而让他们确信"}, {"id": "c1_11.1", "t0": 106.145, "t1": 108.935, "text": "内陆有一个富得惊人的国家"}, {"id": "c2_1.0", "t0": 114.585, "t1": 118.176, "text": "沿海的托托纳克人不堪阿兹特克的重税"}, {"id": "c2_1.1", "t0": 118.216, "t1": 121.343, "text": "在森波阿拉和科尔特斯结了盟"}, {"id": "c2_2.0", "t0": 121.593, "t1": 123.58, "text": "为了断掉手下的退路"}, {"id": "c2_2.1", "t0": 123.62, "t1": 126.899, "text": "科尔特斯下令把船弄沉在岸边"}, {"id": "c2_3.0", "t0": 128.549, "t1": 129.666, "text": "8月16日"}, {"id": "c2_3.1", "t0": 129.706, "t1": 133.759, "text": "西班牙人和托托纳克盟军向内陆出发"}, {"id": "c2_4.0", "t0": 134.409, "t1": 136.803, "text": "他们要翻过东马德雷山脉"}, {"id": "c2_4.1", "t0": 136.843, "t1": 140.291, "text": "从海边一路爬上两千多米的高原"}, {"id": "c2_5.0", "t0": 146.441, "t1": 149.995, "text": "8月底，他们进入了特拉斯卡拉的地界"}, {"id": "c2_6.0", "t0": 150.045, "t1": 154.067, "text": "特拉斯卡拉被阿兹特克的势力包围了几十年"}, {"id": "c2_6.1", "t0": 154.107, "t1": 155.954, "text": "却从没有被征服"}, {"id": "c2_7.0", "t0": 156.204, "t1": 160.891, "text": "双方打了将近三个星期。谁也没能打垮谁"}, {"id": "c2_8.0", "t0": 161.141, "t1": 165.187, "text": "最后，特拉斯卡拉选择结盟。对他们来说"}, {"id": "c2_8.1", "t0": 165.227, "t1": 167.62, "text": "这是对付宿敌的机会"}, {"id": "c2_9.0", "t0": 167.87, "t1": 171.919, "text": "这个决定，比之后任何一场战斗都更重要"}, {"id": "c2_10.0", "t0": 175.569, "t1": 178.564, "text": "10月，在阿兹特克的盟城乔卢拉"}, {"id": "c2_10.1", "t0": 178.604, "t1": 181.179, "text": "科尔特斯声称发现了埋伏"}, {"id": "c2_11.0", "t0": 181.429, "t1": 185.907, "text": "他先动了手。几个小时里，数千人被杀"}, {"id": "c2_12.0", "t0": 192.057, "t1": 195.56, "text": "11月初，他们从两座火山之间的山口"}, {"id": "c2_12.1", "t0": 195.6, "t1": 197.618, "text": "翻进了墨西哥谷地"}, {"id": "c2_13.0", "t0": 199.268, "t1": 201.541, "text": "一个西班牙士兵后来回忆"}, {"id": "c2_13.1", "t0": 201.581, "t1": 203.434, "text": "第一眼看到湖上的城"}, {"id": "c2_13.2", "t0": 203.474, "t1": 205.927, "text": "就像骑士小说里的魔法"}, {"id": "c3_1.0", "t0": 211.577, "t1": 213.542, "text": "1519年11月8日"}, {"id": "c3_1.1", "t0": 213.582, "t1": 216.339, "text": "西班牙人走上了南面的堤道"}, {"id": "c3_2.0", "t0": 216.589, "t1": 220.504, "text": "堤道两边都是水，湖上全是独木舟"}, {"id": "c3_3.0", "t0": 220.754, "t1": 223.852, "text": "据估计，城里住着二十万以上的人"}, {"id": "c3_3.1", "t0": 223.892, "t1": 227.379, "text": "比当时西班牙的任何一座城市都大"}, {"id": "c3_3b.0", "t0": 227.629, "t1": 229.47, "text": "城里有大神庙、宫殿"}, {"id": "c3_3b.1", "t0": 229.51, "t1": 232.994, "text": "还有一个每天几万人来往的大集市"}, {"id": "c3_4.0", "t0": 235.644, "t1": 239.306, "text": "在城门前，蒙特祖马亲自出来迎接"}, {"id": "c3_5.0", "t0": 243.956, "t1": 247.469, "text": "此后不久，西班牙人软禁了蒙特祖马"}, {"id": "c3_5.1", "t0": 247.509, "t1": 249.858, "text": "借他的名义发号施令"}, {"id": "c3_6.0", "t0": 252.508, "t1": 257.007, "text": "科尔特斯在给西班牙国王的信里描述了这座城"}, {"id": "c3_6.1", "t0": 257.047, "t1": 259.958, "text": "1524年，信在纽伦堡出版"}, {"id": "c3_6.2", "t0": 259.998, "t1": 261.798, "text": "附了一张地图"}, {"id": "c3_7.0", "t0": 261.86, "t1": 265.822, "text": "这是欧洲印出的第一张特诺奇蒂特兰地图"}, {"id": "c3_8.0", "t0": 273.472, "t1": 275.069, "text": "1520年春天"}, {"id": "c3_8.1", "t0": 275.109, "t1": 278.344, "text": "古巴总督派纳瓦埃斯带着近千人"}, {"id": "c3_8.2", "t0": 278.384, "t1": 280.184, "text": "来抓科尔特斯"}, {"id": "c3_9.0", "t0": 281.788, "t1": 284.372, "text": "科尔特斯带一部分人赶回海边"}, {"id": "c3_9.1", "t0": 284.412, "t1": 287.992, "text": "夜袭纳瓦埃斯，反而收编了他的人马"}, {"id": "c3_10.0", "t0": 288.242, "t1": 292.055, "text": "纳瓦埃斯的队伍里，很可能还带来了天花"}, {"id": "c3_11.0", "t0": 294.705, "t1": 296.808, "text": "留在城里的阿尔瓦拉多"}, {"id": "c3_11.1", "t0": 296.848, "t1": 299.166, "text": "在托什卡特尔节的庆典上"}, {"id": "c3_11.2", "t0": 299.206, "t1": 302.771, "text": "下令屠杀正在跳舞的阿兹特克贵族"}, {"id": "c3_12.0", "t0": 303.021, "t1": 305.982, "text": "全城暴动。科尔特斯赶回来时"}, {"id": "c3_12.1", "t0": 306.022, "t1": 309.142, "text": "西班牙人已经被围在宫殿里"}, {"id": "c3_13.0", "t0": 310.792, "t1": 313.128, "text": "6月底，蒙特祖马死了"}, {"id": "c3_13.1", "t0": 313.168, "t1": 315.504, "text": "是死在自己人的石块下"}, {"id": "c3_13.2", "t0": 315.544, "t1": 319.933, "text": "还是死在西班牙人手里，至今说法不一"}, {"id": "c3_14.0", "t0": 320.183, "t1": 323.46, "text": "城里推举了新的皇帝：奎特拉瓦克"}, {"id": "c4_1.0", "t0": 329.11, "t1": 331.535, "text": "1520年6月30日深夜"}, {"id": "c4_1.1", "t0": 331.575, "t1": 333.569, "text": "西班牙人决定突围"}, {"id": "c4_2.0", "t0": 333.819, "t1": 336.415, "text": "他们选了最短的一条路：向西"}, {"id": "c4_2.1", "t0": 336.455, "t1": 338.255, "text": "特拉科潘堤道"}, {"id": "c4_3.0", "t0": 339.172, "t1": 341.536, "text": "堤道上的桥已经被拆掉"}, {"id": "c4_3.1", "t0": 341.576, "t1": 343.939, "text": "他们扛着一座活动木桥"}, {"id": "c4_3.2", "t0": 343.979, "t1": 346.733, "text": "一个缺口一个缺口地过"}, {"id": "c4_4.0", "t0": 348.883, "t1": 351.829, "text": "下着雨。他们被发现了"}, {"id": "c4_5.0", "t0": 352.979, "t1": 355.077, "text": "湖面上全是独木舟"}, {"id": "c4_6.0", "t0": 360.727, "t1": 363.75, "text": "很多人身上背着金子，掉进水里"}, {"id": "c4_6.1", "t0": 363.79, "t1": 365.672, "text": "就再也没有上来"}, {"id": "c4_7.0", "t0": 366.122, "t1": 367.968, "text": "西班牙人死了多少"}, {"id": "c4_7.1", "t0": 368.008, "t1": 370.561, "text": "记载从一百多到上千不等"}, {"id": "c4_7.2", "t0": 370.601, "t1": 374.016, "text": "特拉斯卡拉盟军，死了数千人"}, {"id": "c4_8.0", "t0": 376.166, "t1": 379.953, "text": "西班牙人后来把这一夜叫作：悲伤之夜"}, {"id": "c5_1.0", "t0": 385.603, "t1": 387.331, "text": "幸存的人没有退路"}, {"id": "c5_1.1", "t0": 387.371, "t1": 390.152, "text": "只能绕着湖的北岸向东走"}, {"id": "c5_2.0", "t0": 392.802, "t1": 395.094, "text": "7月7日，在奥通巴附近"}, {"id": "c5_2.1", "t0": 395.134, "t1": 397.816, "text": "阿兹特克大军拦住了他们"}, {"id": "c5_3.0", "t0": 398.466, "t1": 401.345, "text": "据记载，西班牙骑兵冲进敌阵"}, {"id": "c5_3.1", "t0": 401.385, "t1": 405.328, "text": "杀死了对方的指挥官，阵线随之溃散"}, {"id": "c5_4.0", "t0": 406.978, "t1": 409.238, "text": "他们逃回了特拉斯卡拉"}, {"id": "c5_4.1", "t0": 409.278, "t1": 412.387, "text": "特拉斯卡拉人没有抛弃他们"}, {"id": "c6_1.0", "t0": 417.037, "t1": 420.472, "text": "这时，另一个敌人进了城：天花"}, {"id": "c6_2.0", "t0": 421.122, "t1": 424.0, "text": "美洲人从来没有接触过这种病"}, {"id": "c6_2.1", "t0": 424.04, "t1": 428.205, "text": "1520年秋天，它在谷地里蔓延开来"}, {"id": "c6_3.0", "t0": 430.355, "t1": 433.224, "text": "12月，新皇帝奎特拉瓦克去世"}, {"id": "c6_3.1", "t0": 433.264, "t1": 435.484, "text": "在位只有八十天左右"}, {"id": "c6_4.0", "t0": 435.734, "t1": 439.016, "text": "他的堂兄弟，二十多岁的夸乌特莫克"}, {"id": "c6_4.1", "t0": 439.056, "t1": 440.856, "text": "继承了王位"}, {"id": "c6_5.0", "t0": 443.094, "t1": 445.897, "text": "科尔特斯明白：要攻下湖上的城"}, {"id": "c6_5.1", "t0": 445.937, "t1": 447.737, "text": "就得在湖上打仗"}, {"id": "c6_6.0", "t0": 447.958, "t1": 449.37, "text": "在特拉斯卡拉"}, {"id": "c6_6.1", "t0": 449.41, "t1": 453.726, "text": "造船匠马丁·洛佩斯造了13艘小型帆船"}, {"id": "c6_6.2", "t0": 453.766, "t1": 455.566, "text": "再拆成零件"}, {"id": "c6_7.0", "t0": 458.476, "t1": 461.936, "text": "数千名特拉斯卡拉人，把它们扛过山"}, {"id": "c6_7.1", "t0": 461.976, "t1": 464.513, "text": "运到了湖边的特斯科科"}, {"id": "c6_8.0", "t0": 467.163, "t1": 470.478, "text": "特斯科科是三城同盟之一。这时"}, {"id": "c6_8.1", "t0": 470.518, "t1": 474.223, "text": "城里的一派已经投向了西班牙人"}, {"id": "c6_9.0", "t0": 476.373, "t1": 479.418, "text": "接下来几个月，科尔特斯沿着湖岸"}, {"id": "c6_9.1", "t0": 479.458, "t1": 483.098, "text": "把一座座城镇打下来，或者拉拢过来"}, {"id": "c6_9b.0", "t0": 483.548, "t1": 487.134, "text": "在伊斯塔帕拉帕，守军掘开堤岸放水"}, {"id": "c6_9b.1", "t0": 487.174, "t1": 490.244, "text": "差点把攻进城的人淹在里面"}, {"id": "c6_10.0", "t0": 494.394, "t1": 496.075, "text": "到1521年春天"}, {"id": "c6_10.1", "t0": 496.115, "t1": 499.088, "text": "特诺奇蒂特兰的盟友一个个离开"}, {"id": "c6_10.2", "t0": 499.128, "t1": 500.928, "text": "它被孤立了"}, {"id": "c6_11.0", "t0": 502.704, "t1": 506.045, "text": "13艘帆船，在特斯科科下水"}, {"id": "c7_1.0", "t0": 511.695, "t1": 514.328, "text": "1521年5月，围城开始"}, {"id": "c7_2.0", "t0": 514.578, "t1": 516.87, "text": "西班牙人只有一千人左右"}, {"id": "c7_2.1", "t0": 516.91, "t1": 520.017, "text": "身边的原住民盟军，数以万计"}, {"id": "c7_3.0", "t0": 521.167, "t1": 525.117, "text": "三路人马，分别堵住三条堤道：特拉科潘"}, {"id": "c7_3.1", "t0": 525.157, "t1": 527.945, "text": "科约阿坎，伊斯塔帕拉帕"}, {"id": "c7_4.0", "t0": 530.095, "t1": 533.703, "text": "他们先切断了查普尔特佩克引水渠"}, {"id": "c7_4.1", "t0": 533.743, "t1": 535.795, "text": "城里的淡水断了"}, {"id": "c7_5.0", "t0": 539.445, "t1": 543.973, "text": "湖上，13艘帆船冲散了成百上千艘独木舟"}, {"id": "c7_6.0", "t0": 548.123, "t1": 551.604, "text": "白天，进攻的一方攻进城里；夜里"}, {"id": "c7_6.1", "t0": 551.644, "t1": 554.576, "text": "守军又把填平的缺口挖开"}, {"id": "c7_7.0", "t0": 555.726, "t1": 557.84, "text": "于是他们开始拆房子"}, {"id": "c7_7.1", "t0": 557.88, "t1": 561.101, "text": "用瓦砾把运河一条一条填平"}, {"id": "c7_8.0", "t0": 563.751, "t1": 566.341, "text": "6月底的一次进攻中了埋伏"}, {"id": "c7_8.1", "t0": 566.381, "t1": 568.922, "text": "科尔特斯自己差点被俘"}, {"id": "c7_9.0", "t0": 569.172, "t1": 571.782, "text": "六十多个西班牙人被活捉"}, {"id": "c7_9.1", "t0": 571.822, "t1": 576.268, "text": "在大神庙上被献祭。营地里的人看得见"}, {"id": "c7_10.0", "t0": 578.918, "t1": 582.136, "text": "但城里更糟：没有水，没有粮"}, {"id": "c7_10.1", "t0": 582.176, "t1": 584.029, "text": "天花还在蔓延"}, {"id": "c7_11.0", "t0": 588.179, "t1": 592.037, "text": "守军一步步退到了北边的特拉特洛尔科"}, {"id": "c7_12.0", "t0": 595.187, "t1": 597.273, "text": "1521年8月13日"}, {"id": "c7_12.1", "t0": 597.313, "t1": 601.702, "text": "夸乌特莫克乘独木舟突围，被一艘帆船截住"}, {"id": "c7_13.0", "t0": 609.352, "t1": 611.479, "text": "特诺奇蒂特兰陷落了"}, {"id": "c7_13.1", "t0": 611.519, "t1": 614.276, "text": "围城持续了大约八十天"}, {"id": "c7_14.0", "t0": 615.426, "t1": 618.279, "text": "有估计说，死者超过十万"}, {"id": "e1.0", "t0": 625.929, "t1": 629.603, "text": "西班牙人在废墟上建起了新的城市"}, {"id": "e1b.0", "t0": 630.453, "t1": 632.852, "text": "夸乌特莫克被关押了几年"}, {"id": "e1b.1", "t0": 632.892, "t1": 636.569, "text": "1525年在一次远征途中被处死"}, {"id": "e1c.0", "t0": 637.719, "t1": 639.588, "text": "对特拉斯卡拉人来说"}, {"id": "e1c.1", "t0": 639.628, "t1": 643.405, "text": "这是打败宿敌的胜利；对阿兹特克人来说"}, {"id": "e1c.2", "t0": 643.445, "t1": 645.703, "text": "这是一个世界的终结"}, {"id": "e2.0", "t0": 646.853, "t1": 650.685, "text": "此后几百年里，湖水被一点一点排干"}, {"id": "e3.0", "t0": 651.835, "t1": 655.95, "text": "今天，堤道成了大街，湖底成了城区"}, {"id": "e4.0", "t0": 657.1, "t1": 661.008, "text": "那座湖上之城，只剩下地图上的轮廓"}]